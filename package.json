{
	"name": "iha-orthodox-resources",
	"version": "1.0.0",
	"description": "Resources for Orthodox Christian websites",
	"author": "In Harmony Arts",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "npm run copy-assets && wp-scripts build --experimental-modules --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "npm run copy-assets && wp-scripts plugin-zip",
		"start": "npm run copy-assets && wp-scripts start --experimental-modules --blocks-manifest",
		"copy-assets": "node src/build/copy-assets.js"
	},
	"dependencies": {
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/interactivity": "^8.0.0",
		"@wordpress/server-side-render": "^7.0.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "^37.0.0"
	}
}
