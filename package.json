{
	"name": "orthodox-calendar-block",
	"version": "1.0.0",
	"description": "Displays the daily Orthodox Calendar information",
	"author": "Dustin Vietzke",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "npm run copy-assets && wp-scripts build --experimental-modules --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "npm run copy-assets && wp-scripts plugin-zip",
		"start": "npm run copy-assets && wp-scripts start --experimental-modules --blocks-manifest",
		"copy-assets": "node src/build/copy-assets.js"
	},
	"dependencies": {
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/components": "^40.0.0",
		"@wordpress/element": "^8.5.0",
		"@wordpress/i18n": "latest",
		"@wordpress/interactivity": "^6.56.0",
		"@wordpress/server-side-render": "^6.29.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "^36.0.0"
	}
}
